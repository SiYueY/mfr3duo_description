<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Consolidated from tmr_inertia.xacro. -->

  <!-- ========================================= -->
  <!-- ||         Inertia Utilities           || -->
  <!-- ========================================= -->

  <!-- According to https://en.wikipedia.org/wiki/List_of_moments_of_inertia#List_of_3D_inertia_tensors -->
  <xacro:macro name="inertia-cylinder" params="mass radius h">
    <inertial>
      <mass value="${mass}" />
      <inertia ixx="${1./12 * mass * (3 * radius**2 + h**2)}" ixy = "0" ixz = "0"
               iyy="${1./12 * mass * (3 * radius**2 + h**2)}" iyz = "0"
               izz="${1./2  * mass * radius**2}" />
    </inertial>
  </xacro:macro>

  <!-- According to https://en.wikipedia.org/wiki/List_of_moments_of_inertia#List_of_3D_inertia_tensors -->
  <xacro:macro name="inertia-sphere" params="mass radius">
    <inertial>
      <mass value="${mass}" />
      <inertia ixx="${2./5 * mass * radius**2}" ixy="0" ixz="0"
               iyy="${2./5 * mass * radius**2}" iyz="0"
               izz="${2./5 * mass * radius**2}" />
    </inertial>
  </xacro:macro>

  <!-- According to https://en.wikipedia.org/wiki/List_of_moments_of_inertia#List_of_3D_inertia_tensors -->
  <xacro:macro name="inertia-box" params="mass width depth height *origin">
    <inertial>
      <mass value="${mass}" />
      <inertia ixx="${1./12 * mass * (height**2 + depth**2)}" ixy="0" ixz="0"
               iyy="${1./12 * mass * (width**2  + height**2)}" iyz="0"
               izz="${1./12 * mass * (width**2  + depth**2)}" />
      <xacro:insert_block name="origin" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertia-torso">
    <inertial>
      <origin xyz="-0.374101 0.001522 0.120542" rpy="0 0 0" />
      <mass value="75.711368" />
      <inertia  ixx ="1.822241406454"	ixy ="0.009367998445"	ixz ="0.855091055826"
	              iyx ="0.009367998445"	iyy ="4.242134556907"	iyz ="-0.012022054390"
	              izx ="0.855091055826"	izy ="-0.012022054390" izz ="4.568496104964"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertia-default" params="mass">
    <inertial>
      <mass value="${mass}" />
      <inertia ixx="0.1" iyy="0.1" izz="0.1"
               ixy="0"   ixz="0"   iyz="0" />
    </inertial>
  </xacro:macro>

  <!-- Consolidated from tmr_argo_drive.xacro. -->


  <xacro:macro name="argo_drive" params="name mobile_robot_type parent length:='0.04' radius:='0.05' offset_wheel_sign:='1' *origin">

    <xacro:property name="base_width" value="0.17" />
    <xacro:property name="base_depth" value="0.25" />
    <xacro:property name="base_height" value="0.077" />
    <xacro:property name="offset_wheel" value="0.085" />
    <xacro:property name="mass" value="2.5" />

    <xacro:if value="${name == 'argo_drive_front'}">
      <xacro:property name="steering_joint" value="0" />
      <xacro:property name="driving_joint" value="1" />
    </xacro:if>
    <xacro:if value="${name == 'argo_drive_rear'}">
      <xacro:property name="steering_joint" value="2" />
      <xacro:property name="driving_joint" value="3" />
    </xacro:if>

    <link name="${name}_fixed_link" >
      <xacro:macro name="argo_drive_base_geometry" params="xyz:='0 0 0'">
        <origin xyz="0 ${offset_wheel_sign*(base_depth/2 - offset_wheel)} ${base_height/2 - 0.004}" />
        <geometry>
          <box size="${base_width} ${base_depth} ${base_height}" />
        </geometry>
        <material name="darkgrey">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </xacro:macro>

      <visual>
        <xacro:argo_drive_base_geometry/>
      </visual>
      <collision>
        <xacro:argo_drive_base_geometry/>
      </collision>
      <inertial>
        <origin xyz="-0.00019 ${offset_wheel_sign*0.04522} 0.02947" rpy="0 0 0"/>
        <mass value="7.0"/>
        <inertia
          ixx="0.07060497424"
          ixy="-0.00025482709"
          ixz="${offset_wheel_sign* (-0.00006283102)}"
          iyy="0.03433835031"
          iyz="${offset_wheel_sign*0.00249596715}"
          izz="0.08926325955"/>
      </inertial> 
    </link>

    <joint name="${name}_fixed_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child  link="${name}_fixed_link" />
    </joint>

    <link name="${name}_steering_link">
     <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="2.0"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0"
                 iyy="0.001" iyz="0.0"
                 izz="0.001"/>
      </inertial>
    </link>

    <joint name="${mobile_robot_type}_joint_${steering_joint}" type="continuous">
      <origin xyz="0 0 0"/>
      <parent link="${name}_fixed_link" />
      <child  link="${name}_steering_link" />
      <axis   xyz="0 0 1" />
      <limit  effort="500" velocity="20" />
      <dynamics damping="20.0" friction="5.0"/>
    </joint>

    <link name="${name}_link" >
      <xacro:macro name="argo_drive_geometry">
        <origin rpy="${pi/2} 0 0" />
        <geometry>
           <cylinder length="${length}" radius="${radius}" />
        </geometry>
        <material name="yellowish_brown">
          <color rgba="0.8 0.6 0.2 1.0"/>
        </material>
      </xacro:macro>

      <visual>
        <xacro:argo_drive_geometry/>
      </visual>
      <collision>
        <xacro:argo_drive_geometry/>
      </collision>

      <xacro:inertia-cylinder mass="${mass}" radius="${radius}" h="${length}" />

    </link>

    <joint name="${mobile_robot_type}_joint_${driving_joint}" type="continuous">
      <origin xyz ="0 0 0" rpy="0 0 0" />
      <parent link="${name}_steering_link" />
      <child  link="${name}_link" />
      <axis   xyz="0 1 0" />
      <limit  effort="500" velocity="20"/>
      <dynamics damping="5.0" friction="1.0"/>
    </joint>

  </xacro:macro>

  <!-- Consolidated from tmr_caster_wheel.xacro. -->


  <xacro:macro name="caster_wheel" params="name parent length:='0.015' radius:='0.03' caster_joint_z:='-0.05' caster_steering_offset:='-0.035' *origin">

    <xacro:property name="base_width" value="0.04" />
    <xacro:property name="base_depth" value="0.03" />
    <xacro:property name="base_height" value="0.003" />
    <xacro:property name="mass" value="0.5" />

    <link name="${name}_fixed_link" >
      <xacro:macro name="caster_base_geometry" params="xyz:='0 0 0'">
        <origin xyz="0 0 ${-base_height/2}" />
        <geometry>
          <box size="${base_width} ${base_depth} ${base_height}" />
        </geometry>
        <material name="darkgrey">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </xacro:macro>

      <visual>
        <xacro:caster_base_geometry/>
      </visual>
      <collision>
        <xacro:caster_base_geometry/>
      </collision>
      <inertial>
        <origin xyz="-0.02365 0.00005 -0.03651" rpy="0 0 0"/>
        <mass value="0.3"/>
        <inertia
          ixx="0.00049538079"
          ixy="-0.00000042663"
          ixz="0.00020926011"
          iyy="0.00070424109"
          iyz="-0.00000050221"
          izz="0.00048449394"/>
      </inertial>
    </link>

    <joint name="${name}_fixed_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child  link="${name}_fixed_link" />
    </joint>

    <link name="${name}_steering_link">
      <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="0.2"/>
          <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                   iyy="0.0001" iyz="0.0" 
                   izz="0.0001"/>
      </inertial>
    </link>

    <joint name="${name}_steering_joint" type="continuous">
      <origin xyz="0 0 0"/>
      <parent link="${name}_fixed_link" />
      <child  link="${name}_steering_link" />
      <axis   xyz="0 0 1" />
      <limit  effort="500" velocity="20" />
      <dynamics damping="0.003" friction="0.0"/>
    </joint>

    <link name="${name}_link" >
      <xacro:macro name="caster_wheel_geometry">
        <origin rpy="${pi/2} 0 0" />
        <geometry>
           <cylinder length="${length}" radius="${radius}" />
        </geometry>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </xacro:macro>

      <visual>
        <xacro:caster_wheel_geometry/>
      </visual>
      <collision>
        <xacro:caster_wheel_geometry/>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                 iyy="0.0001" iyz="0.0"
                 izz="0.0001"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="continuous">
      <origin xyz ="${caster_steering_offset} 0 ${caster_joint_z}" rpy="0 0 0" />
      <parent link="${name}_steering_link" />
      <child  link="${name}_link" />
      <axis   xyz="0 1 0" />
      <limit  effort="500" velocity="20" />
      <dynamics damping="0.003" friction="0.0"/>
    </joint>

  </xacro:macro>

  <!-- Consolidated from tmr_rocker_arm.xacro. -->


  <xacro:macro name="rocker_arm" params="name mass parent *origin">
    <xacro:property name="depth" value="0.32"/>
    <xacro:property name="width" value="0.02"/>
    <xacro:property name="height" value="0.015"/>

    <link name="${name}_link" >
      <visual>
        <origin rpy="${pi/2} 0 ${pi/2}" />
        <geometry>
          <cylinder radius="${height}" length="${height*1.5}" />
        </geometry>
        <material name="darkgrey">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 ${pi/2}" />
        <geometry>
          <cylinder radius="${height}" length="${height*1.5}" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.000344 -0.021232 0.038239" rpy="0 0 0"/>
        <mass value="5.183973"/>
        <inertia
          ixx="0.067087560015" 
          ixy="-0.000078335851" 
          ixz="0.000041831678" 
          iyy="0.023113173265" 
          iyz="0.007148473123" 
          izz="0.081148329632"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="revolute">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child  link="${name}_link" />
      <axis   xyz="1 0 0" />
      <limit  effort="500" velocity="20" upper="0.18" lower="-0.16"/>
      <dynamics damping="0.003" friction="0.0"/>
    </joint>

  </xacro:macro>

  <!-- Consolidated from tmr.xacro. -->

  <xacro:macro name="tmrv0_2"
    params="mobile_robot_type
                  reduced_version:=false
                  robot_namespace:=''
                  gazebo:=false">
    <xacro:property name="caster_radius" value="0.03"/>
    <xacro:property name="caster_x" value="0.3"/>
    <xacro:property name="caster_y" value="0.2"/>
    <xacro:property name="caster_z" value="0.08"/>

    <xacro:property name="rocker_arm_x" value="-0.3"/>
    <xacro:property name="rocker_arm_y" value="0.0"/>
    <xacro:property name="rocker_arm_z" value="0.0845"/>

    <xacro:property name="argo_drive_radius" value="0.05"/>
    <xacro:property name="argo_drive_x" value="0.3"/>
    <xacro:property name="argo_drive_y" value="0.2"/>
    <xacro:property name="argo_drive_z" value="0.05"/>

    <!-- Main Platform Chassis -->
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://mfr3duo_description/urdf/meshes/franka_tmr/visual/tmrv0_2.dae"/>
        </geometry>
        <material name="white">
          <color rgba="1.0 1.0 1.0 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://mfr3duo_description/urdf/meshes/franka_tmr/collision/tmrv0_2.stl"/>
        </geometry>
      </collision>
    </link>
    
    <link name="base_inertia">
      <inertial>
        <origin xyz="0.006619 -0.002210 0.184355" rpy="0 0 0"/>
        <mass value="88.954183"/>
        <inertia
          ixx="3.245524271774"
          ixy="0.007060314402"
          ixz="-0.134604220439"
          iyy="4.162370636125"
          iyz="-0.010770547630"
          izz="5.841473351812"/>
      </inertial>
    </link>

    <joint name="base_inertia_joint" type="fixed">
      <parent link="base_link"/>
      <child link="base_inertia"/>
    </joint>

    <!-- wheels and suspension -->
    <!-- front -->
    <xacro:unless value="${reduced_version}">
      <xacro:caster_wheel name="caster_front_left" parent="base_link"
        radius="${caster_radius}">
        <origin xyz="${caster_x} ${caster_y} ${caster_z}"/>
      </xacro:caster_wheel>
    </xacro:unless>

    <xacro:argo_drive name="argo_drive_front" mobile_robot_type="${mobile_robot_type}" parent="base_link"
      offset_wheel_sign="1"
      radius="${argo_drive_radius}">
      <origin xyz="${argo_drive_x} ${-argo_drive_y} ${argo_drive_z}"/>
    </xacro:argo_drive>

    <!-- rear -->

    <xacro:rocker_arm name="rocker_arm" mass="3" parent="base_link">
      <origin xyz="${rocker_arm_x} ${rocker_arm_y} ${rocker_arm_z}"/>
    </xacro:rocker_arm>

    <xacro:unless value="${reduced_version}">
      <xacro:caster_wheel name="caster_rear_right" parent="rocker_arm_link"
        radius="${caster_radius}">
        <origin
          xyz="${-caster_x - rocker_arm_x} ${-caster_y - rocker_arm_y} ${caster_z - rocker_arm_z}"/>
      </xacro:caster_wheel>
    </xacro:unless>

    <xacro:argo_drive name="argo_drive_rear" mobile_robot_type="${mobile_robot_type}" parent="rocker_arm_link"
      offset_wheel_sign="-1"
      radius="${argo_drive_radius}">
      <origin
        xyz="${-argo_drive_x - rocker_arm_x} ${argo_drive_y - rocker_arm_y} ${argo_drive_z - rocker_arm_z}"/>
    </xacro:argo_drive>

    <!-- Mounting Points -->
    <!-- IMU -->
    <link name="imu_mounting_point"/>
    <joint name="imu_mounting_point_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_mounting_point"/>
      <origin xyz="0.260 0.0 0.1478" rpy="${pi} 0 0"/>
    </joint>

    <!-- Cameras -->
    <link name="front_mounting_point"/>
    <joint name="front_mounting_point_joint" type="fixed">
      <parent link="base_link"/>
      <child link="front_mounting_point"/>
      <origin xyz="0.380705 0.0 0.2345" rpy="${pi} 0 0"/>
    </joint>
    <link name="rear_mounting_point"/>
    <joint name="rear_mounting_point_joint" type="fixed">
      <parent link="base_link"/>
      <child link="rear_mounting_point"/>
      <origin xyz="-0.380705 0.0 0.2345" rpy="${pi} 0 ${pi}"/>
    </joint>
    <link name="right_mounting_point"/>
    <joint name="right_mounting_point_joint" type="fixed">
      <parent link="base_link"/>
      <child link="right_mounting_point"/>
      <origin xyz="0.0 -0.272712 0.1145" rpy="${pi} 0 -${pi/2}"/>
    </joint>
    <link name="left_mounting_point"/>
    <joint name="left_mounting_point_joint" type="fixed">
      <parent link="base_link"/>
      <child link="left_mounting_point"/>
      <origin xyz="0.0 0.272712 0.1145" rpy="${pi} 0 ${pi/2}"/>
    </joint>
    <!-- Lidars -->
    <link name="lidar_front_mounting_point"/>
    <joint name="lidar_front_mounting_point_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_front_mounting_point"/>
      <origin xyz="0.3275 0.2175 0.19065" rpy="0 ${pi} ${pi*3/4}"/>
    </joint>

    <link name="lidar_rear_mounting_point"/>
    <joint name="lidar_rear_mounting_point_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_rear_mounting_point"/>
      <origin xyz="-0.3275 -0.2175 0.19065" rpy="0 ${pi} ${pi*7/4}"/>
    </joint>

  </xacro:macro>

  <!-- Consolidated from franka_mobile_base.xacro. -->

  <xacro:macro
    name="mfr3duo_mobile_base"
    params="            hand
            gazebo
            reduced_version
            description_pkg
            connected_to
            use_arms
            no_prefix
            ee_id
            special_connection
            xyz_ee
            rpy_ee
            tcp_xyz
            tcp_rpy
            safety_distance
            with_sc">
    <xacro:property name="arm_prefixes_list" value="${['left','right']}"/>

    <!-- The mobile base -->
    <xacro:tmrv0_2
      mobile_robot_type="tmrv0_2"
      reduced_version="${reduced_version}"
      gazebo="${gazebo}"/>

    <!-- Spine -->
    <xacro:franka_spine parent="base_link"/>

    <!-- The fixed FR3v2.1 Duo arms -->
    <xacro:fr3_duo
      name="fr3_duo"
      hand="${hand}"
      ee_id="${ee_id}"
      special_connection="${special_connection}"
      xyz_ee="${xyz_ee}"
      rpy_ee="${rpy_ee}"
      tcp_xyz="${tcp_xyz}"
      tcp_rpy="${tcp_rpy}"
      safety_distance="${safety_distance}"
      with_sc="${with_sc}"
      gazebo="${gazebo}"
      description_pkg="${description_pkg}"
      base_mount="franka_spine_mounting_point"
      connected_to="${connected_to}"
      arm_prefixes="${arm_prefixes_list}"
      is_mfr3duo="true"/>

  </xacro:macro>
</robot>
